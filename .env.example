PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nme_news_db
JWT_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
BCRYPT_SALT_ROUNDS=12
USE_MEMORY_DB_IF_LOCAL_FAILS=false

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=nme_news_media
